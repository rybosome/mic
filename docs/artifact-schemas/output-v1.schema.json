{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rybosome.github.io/mic/artifact-schemas/output-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mic-output-v1"
        },
        "type": {
          "const": "output"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "evaluation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "row_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trial": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scorer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "type",
        "stream",
        "evaluation",
        "source_id",
        "row_index",
        "trial",
        "scorer",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mic-output-v1"
        },
        "type": {
          "const": "truncated"
        },
        "limit_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "type",
        "limit_bytes"
      ],
      "additionalProperties": false
    }
  ]
}
