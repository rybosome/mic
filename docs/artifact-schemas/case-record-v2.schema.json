{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rybosome.github.io/mic/artifact-schemas/case-record-v2.schema.json",
  "title": "Mic v2 case execution record",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "input": {},
    "expected": {},
    "metadata": {
      "type": "object"
    },
    "row_index": {
      "type": "integer",
      "minimum": 0
    },
    "trial": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "scores": {
      "type": "array",
      "items": {
        "$ref": "common-v2.schema.json#/$defs/score"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "common-v2.schema.json#/$defs/error"
      }
    },
    "latency": {
      "$ref": "common-v2.schema.json#/$defs/latency"
    },
    "provenance": {
      "type": "object"
    },
    "output": {},
    "task_metadata": {
      "type": "object"
    }
  },
  "required": [
    "case_id",
    "input",
    "row_index",
    "trial",
    "status",
    "scores",
    "errors",
    "latency",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "output"
        ],
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
