{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rybosome.github.io/mic/artifact-schemas/run-v3.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mic-run-v3"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "running"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mic-run-v3"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            130
          ]
        },
        "summary": {
          "$ref": "common-v3.schema.json#/$defs/summary"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common-v3.schema.json#/$defs/source"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "expression",
              "actual",
              "passed",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "common-v3.schema.json#/$defs/failure"
          }
        },
        "sinks": {
          "type": "array",
          "items": {
            "$ref": "common-v3.schema.json#/$defs/receipt"
          }
        },
        "output_dir": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "info": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "tasks": {
                  "type": "object"
                }
              },
              "required": [
                "run_id",
                "started_at",
                "tasks"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "status",
        "exit_code",
        "summary",
        "sources",
        "requirements",
        "failures",
        "sinks",
        "output_dir",
        "info"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 130
              }
            }
          }
        }
      ]
    }
  ]
}
