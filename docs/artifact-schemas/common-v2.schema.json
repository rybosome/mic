{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rybosome.github.io/mic/artifact-schemas/common-v2.schema.json",
  "title": "Shared Mic v2 evidence structures",
  "$defs": {
    "reporterFailure": {
      "type": "object",
      "properties": {"status": {"const": "failed"}, "error": {"type": "string"}, "type": {"type": "string"}},
      "required": ["status", "error", "type"],
      "additionalProperties": false
    },
    "reporterCancellation": {
      "type": "object",
      "properties": {"status": {"const": "cancelled"}, "error": {"type": "string"}},
      "required": ["status", "error"],
      "additionalProperties": false
    },
    "braintrustResult": {
      "type": "object",
      "properties": {
        "status": {"const": "completed"},
        "rows": {"type": "integer", "minimum": 0},
        "flushed": {"const": true},
        "url": {"type": "string"},
        "experiment_id": {"type": "string"}
      },
      "required": ["status", "rows", "flushed"],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "value",
        "metadata"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "task",
            "schema",
            "scorer",
            "cancelled",
            "configuration",
            "dataset",
            "artifact",
            "reporting"
          ]
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "row_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trial": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "traceback": {
          "type": "string"
        },
        "scorer": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "phase",
        "type",
        "message",
        "row_index",
        "case_id",
        "trial",
        "traceback"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "p95": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "count",
        "mean",
        "min",
        "max",
        "p50",
        "p95"
      ],
      "additionalProperties": false
    },
    "scoreStats": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "p50": {
          "type": [
            "number",
            "null"
          ]
        },
        "p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "null_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "count",
        "mean",
        "min",
        "max",
        "p50",
        "p95",
        "null_count",
        "unavailable_count"
      ],
      "additionalProperties": false
    },
    "latency": {
      "type": "object",
      "properties": {
        "task_ms": {
          "type": "number",
          "minimum": 0
        },
        "scoring_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "task_ms",
        "scoring_ms",
        "total_ms"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "max_executions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "trials",
        "concurrency",
        "timeout",
        "max_executions"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "object"
        },
        "schema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "object"
            },
            "expected": {
              "type": "object"
            },
            "metadata": {
              "type": "object"
            },
            "expected_policy": {
              "enum": [
                "required",
                "optional"
              ]
            }
          },
          "required": [
            "input",
            "expected",
            "metadata",
            "expected_policy"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "rows",
        "bytes",
        "digest",
        "provenance",
        "schema",
        "selection"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "package_version": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "framework_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "python",
        "package_version",
        "definition",
        "dependencies",
        "framework_sha256"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string"
        },
        "metric": {
          "type": "string",
          "pattern": "\\S"
        },
        "actual": {
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "expression",
        "metric",
        "actual",
        "passed"
      ],
      "additionalProperties": false
    }
  }
}
